      get: query(
        { description: "Retrieve a program by its ID.", input: object({ programId: string({ minLength: 1 }) }) },
        async (_ctx, { programId }) => c.get(`/programs/${enc(programId)}/`),
      ),
      listAffiliates: query(
        {
