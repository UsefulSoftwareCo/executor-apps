      ),
      disapprove: mutation(
        { description: "Disapprove a commission.", input: object({ commissionId: string({ minLength: 1 }) }), approval: always() },
        async (_ctx, { commissionId }) => c.send("DELETE", `/commissions/${enc(commissionId)}/approved/`),
      ),
    }),
    payments: router({
      list: query(
        { description: "List payments.", input: object({ page }) },
        async (_ctx, { page }) => c.get("/payments/", { page }),
      ),
      get: query(
        { description: "Retrieve a payment by ID.", input: object({ paymentId: string({ minLength: 1 }) }) },
        async (_ctx, { paymentId }) => c.get(`/payments/${enc(paymentId)}/`),
      ),
      listBalances: query(
        { description: "List all non-zero affiliate balances (not paginated).", input: object({}) },
        async () => c.get("/balances/"),
      ),
      create: mutation(
        {
          description:
            "Pay out affiliate balances. Each payment needs affiliate_id, amount and currency. Pass several payments at once in payments.",
          input: object({
            payments: array(object({ affiliate_id: string({ minLength: 1 }), amount: number(), currency: string({ minLength: 3 }) })),
          }),
          approval: always(),
        },
        async (_ctx, { payments }) => c.send("POST", "/payments/", payments),
      ),
      cancel: mutation(
        { description: "Cancel a payment; the amount returns to the affiliate's balance.", input: object({ paymentId: string({ minLength: 1 }) }), approval: always() },
        async (_ctx, { paymentId }) => c.send("DELETE", `/payments/${enc(paymentId)}/`),
      ),
    }),
    clicks: router({
      list: query(
        {
          description: "List clicks (Enterprise plan only). Filters: programId, affiliateId, dateFrom, dateTo (YYYY-MM-DD), page.",
          input: object({
            programId: string().optional(),
            affiliateId: string().optional(),
            dateFrom: string().optional(),
            dateTo: string().optional(),
            page,
          }),
        },
        async (_ctx, { programId, affiliateId, dateFrom, dateTo, page }) =>
          c.get("/clicks/", { program_id: programId, affiliate_id: affiliateId, date_from: dateFrom, date_to: dateTo, page }),
      ),
      get: query(
        { description: "Retrieve detailed information about a click by UUID (Enterprise plan only).", input: object({ id: string({ minLength: 1 }) }) },
        async (_ctx, { id }) => c.get(`/clicks/${enc(id)}/`),
      ),
      create: mutation(
        {
          description: "Record a click. body: { referral_code (required), source_id?, meta_data?, referrer?, landing_page?, user_agent?, ip? }. Returns a click ID usable as click_id when creating a conversion.",
          input: object({ body: bodyField }),
          approval: always(),
        },
        async (_ctx, { body }) => c.send("POST", "/clicks/", body),
      ),
    }),
  });
}

export default defineApp(
  { accounts: { tapfiliate: tapfiliate.many() } },
  async ({ accounts, fetch, signal }) => ({
    tools: router(
      await accountRouter(accounts.tapfiliate, (account) => tools(client(account.fields.token, fetch, signal)), { signal }),
      {
        title: "Tapfiliate",
        description:
          "Tapfiliate affiliate tracking: programs, affiliates and groups, prospects, customers, conversions, commissions, payments, balances and clicks.",
        icons,
      },
    ),
  }),
);
