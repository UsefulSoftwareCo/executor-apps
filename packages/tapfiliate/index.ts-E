import {
  accountRouter,
  array,
  decodeJson,
  defineApp,
  defineProvider,
  json,
  mutation,
  number,
  object,
  query,
  record,
  router,
  secrets,
  string,
} from "apps";
import { always } from "apps/operations/approval";
import { icons } from "./icon.js";

const base = "https://api.tapfiliate.com/1.6";

const tapfiliate = defineProvider({
  name: "Tapfiliate",
  hosts: ["api.tapfiliate.com"],
  auth: {
    apiKey: secrets({
      label: "API key",
      fields: object({ token: string({ minLength: 1 }) }),
    }),
  },
  async health({ account, fetch, signal }) {
    const response = await fetch(`${base}/programs/`, {
      signal,
      headers: { "X-Api-Key": account.fields.token },
    });
    await decodeJson(response, array(json()));
  },
});

type Fetch = typeof fetch;
type Params = Record<string, unknown>;

function client(token: string, fetcher: Fetch, signal: AbortSignal | undefined) {
  const url = (path: string, params: Params = {}) => {
    const u = new URL(`${base}${path}`);
    for (const [key, value] of Object.entries(params)) {
      if (value !== undefined && value !== null) u.searchParams.set(key, String(value));
    }
    return u.toString();
  };
  const call = async (method: string, path: string, params: Params = {}, body?: unknown) => {
    const response = await fetcher(url(path, params), {
      method,
      signal,
      headers: {
        "X-Api-Key": token,
        accept: "application/json",
        ...(body === undefined ? {} : { "content-type": "application/json" }),
      },
      ...(body === undefined ? {} : { body: JSON.stringify(body) }),
    });
    const text = await response.text();
    if (!response.ok) throw new Error(`Tapfiliate returned ${response.status}: ${text.slice(0, 500)}`);
    const next = /<[^>]*[?&]page=(\d+)[^>]*>;\s*rel="next"/.exec(response.headers.get("link") ?? "")?.[1];
    const data: unknown = text.length === 0 ? { ok: true, status: response.status } : JSON.parse(text);
    return next === undefined ? data : { data, nextPage: Number(next) };
  };
  return {
    get: (path: string, params?: Params) => call("GET", path, params),
    send: (method: "POST" | "PUT" | "PATCH" | "DELETE", path: string, body?: unknown, params?: Params) =>
      call(method, path, params, body),
  };
}

type Client = ReturnType<typeof client>;

const page = number().optional();
const bodyField = record(json());
const enc = encodeURIComponent;

